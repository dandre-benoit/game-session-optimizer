# La configuration appartient a l'utilisateur : elle contient ses applications,
# ses services et l'emplacement de ses jeux. Le modele livre est
# config.exemple.ini, dont config.ini est cree au premier lancement.
config.ini

# Etat entre deux parties : ce qui a ete ferme, ou se trouve chaque jeu.
# Le dossier est versionne (via .gitkeep), son contenu ne l'est jamais.
state/*
!state/.gitkeep
